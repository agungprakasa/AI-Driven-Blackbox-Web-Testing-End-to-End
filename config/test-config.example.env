# ============================================================
# Contoh konfigurasi environment testing
# Salin file ini menjadi test-config.env lalu isi nilai aktual.
# test-config.env TIDAK BOLEH di-commit (lihat .gitignore).
# ============================================================

# --- Target Aplikasi ---
APP_BASE_URL=https://staging.example.com
APP_ENV=staging

# --- Browser ---
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=true             # true | false
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
SLOWMO_MS=0               # delay ms per aksi (debug visual)

# --- Timeout (ms) ---
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# --- Akun Test ---
TEST_USER_ADMIN=
TEST_USER_REGULAR=
TEST_PASSWORD=

# --- API (opsional) ---
API_BASE_URL=
API_KEY=

# --- Reporting ---
REPORT_TITLE=QA Web Testing Report
EVIDENCE_DIR=evidence
PLAYWRIGHT_REPORT_DIR=reports/playwright
